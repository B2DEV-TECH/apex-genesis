page 1 (
    name: Create experiment
    alias: CREATE
    title: Create | Genesis Living Control
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authentication: required
        pageAccessProtection: argumentsMustHaveChecksum
    }
    region create-request (
        name: Create bounded experiment
        type: staticContent
        layout {
            sequence: 10
            slot: body
            columnSpan: 12
            startNewRow: true
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        source {
            htmlCode: ```html
<section id="living-control">
 <p>Order Lab · GA_ONLY · fixed synthetic tasks</p>
 <p data-status role="status">Control is disabled or not configured.</p>
 <p>Create saves an immutable draft. Start Evolution queues that draft for an authorized worker.</p>
 <label>Experiment label <input name="label" maxlength="120" required disabled></label>
 <p>Initial feasibility capability: seed 50000, one challenger, two application materializations.</p>
 <label>Random seed <input name="seed" type="number" min="50000" max="50000" value="50000" readonly required disabled></label>
 <label>Challenger generations <input name="generations" type="number" min="1" max="1" value="1" readonly required disabled></label>
 <label>Application materialization budget <input name="materializationBudget" type="number" min="2" max="2" value="2" readonly required disabled></label>
 <button type="button" data-action="CREATE" disabled>Create draft</button>
 <label>Existing requests <select data-requests disabled></select></label>
 <div data-observation aria-live="polite"></div>
</section>
            ```
        }
    )
    process living-control (
        name: LIVING_CONTROL
        type: executeCode
        source {
            plsqlCode: ```plsql
apxgen_app_control.ajax;
            ```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
    )
)
