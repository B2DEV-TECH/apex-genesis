page 8 (
 name: Experiment Configuration
 alias: GENESIS-8
 title: Experiment Configuration | APEX Genesis
 appearance {
 pageTemplate: @/standard
 templateOptions: #DEFAULT#
 }
 navigation {
 warnOnUnsavedChanges: false
 }
 security {
 authentication: required
 pageAccessProtection: argumentsMustHaveChecksum
 }
 region genesis-laboratory (
 name: Experiment Configuration
 type: staticContent
 layout {
 sequence: 10
 slot: body
 columnSpan: 12
 startNewRow: true
 }
 appearance {
 template: @/blank-with-attributes
 templateOptions: #DEFAULT#
 }
 source {
 htmlCode: ```html
<div class="analytics-card"><p class="eyebrow">SAFE DEFAULTS / PROVIDER DISABLED</p><h1>Experiment Configuration</h1>
<p>Every run uses synthetic data. AI requires separately configured credentials, reviewed prices, model verification and explicit owner opt-in. Creating a run never enables paid requests. Configuration becomes immutable after initialization.</p>
<div class="configuration-grid"><label>Experiment name<input id="new-label" value="Local Genesis experiment" maxlength="120"></label><label>Population<select id="new-mode"><option>GA_ONLY</option><option>RANDOM_SEARCH</option><option>GA_HAIKU</option></select></label>
<label>Seed<input id="new-seed" type="number" min="1" max="2147483646" step="1" value="42"></label><label>Population size<input id="new-size" type="number" min="4" max="100" step="1" value="12"></label><label>Generations<input id="new-generations" type="number" min="1" max="1000" step="1" value="5"></label>
<label>Mutation rate<input id="new-mutation" type="number" min="0" max="1" step="0.01" value="0.25"></label><label>Crossover rate<input id="new-crossover" type="number" min="0" max="1" step="0.01" value="0.75"></label><label>Elites<input id="new-elites" type="number" min="0" max="99" step="1" value="2"></label><label>Tournament size<input id="new-tournament" type="number" min="2" max="10" step="1" value="3"></label>
<label>Diversity threshold<input id="new-diversity" type="number" min="0" max="1" step="0.01" value="0.3"></label><label>Stagnation window<input id="new-stagnation" type="number" min="1" max="1000" step="1" value="10"></label><label>Generation timeout / seconds<input id="new-generation-timeout" type="number" min="30" max="7200" step="1" value="1200"></label><label>Total timeout / seconds<input id="new-total-timeout" type="number" min="30" max="86400" step="1" value="21600"></label></div>
<h2>Technical fitness weights</h2><p>Weights must sum to one. Hard accessibility, structure and responsive constraints remain mandatory. New weights define a new experimental condition.</p><div class="configuration-grid">
<label>Accessibility<input id="weight-accessibility" type="number" min="0" max="1" step="0.01" value="0.4"></label><label>Hierarchy<input id="weight-hierarchy" type="number" min="0" max="1" step="0.01" value="0.25"></label><label>Responsiveness<input id="weight-responsiveness" type="number" min="0" max="1" step="0.01" value="0.25"></label><label>DOM performance proxy<input id="weight-performance" type="number" min="0" max="1" step="0.01" value="0.1"></label></div>
<button id="create-experiment" type="button">Create and start experiment</button><p id="create-status" role="status"></p><p>A Node/Playwright worker supplies real browser observations; DBMS_SCHEDULER advances ready generations. Limits and types are validated in Oracle.</p></div>
```
 }
 )
